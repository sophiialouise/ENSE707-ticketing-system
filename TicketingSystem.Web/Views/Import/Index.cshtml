@model TicketingSystem.Models.TicketImportResult?

@{
    ViewData["Title"] = "Import Tickets";
}

<div class="container mt-4">

    <div class="mb-4">
        <h1>Import Tickets</h1>

        <p class="text-muted">
            Upload a CSV file containing support ticket records.
        </p>
    </div>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">
            @ViewBag.ErrorMessage
        </div>
    }

    <div class="card shadow-sm mb-4">

        <div class="card-header">
            CSV Import
        </div>

        <div class="card-body">

            <form
                asp-controller="Import"
                asp-action="Index"
                method="post"
                enctype="multipart/form-data">

                <div class="mb-3">

                    <label
                        for="file"
                        class="form-label">
                        Select CSV File
                    </label>

                    <input
                        type="file"
                        id="file"
                        name="file"
                        class="form-control"
                        accept=".csv"
                        required />

                </div>

                <button
                    type="submit"
                    class="btn btn-primary">
                    Import Tickets
                </button>

            </form>

        </div>

    </div>

    @if (Model != null)
    {
        <div class="card shadow-sm">

            <div class="card-header">
                Import Results
            </div>

            <div class="card-body">

                <div class="row mb-4">

                    <div class="col-md-6">
                        <h6 class="text-muted">
                            Valid Records
                        </h6>

                        <h2>@Model.ValidRecords</h2>
                    </div>

                    <div class="col-md-6">
                        <h6 class="text-muted">
                            Invalid Records
                        </h6>

                        <h2>@Model.InvalidRecords</h2>
                    </div>

                </div>

                @if (Model.Errors.Any())
                {
                    <h5>Validation Issues</h5>

                    <ul class="mb-0">
                        @foreach (var error in Model.Errors)
                        {
                            <li>@error</li>
                        }
                    </ul>
                }
                else
                {
                    <div class="alert alert-success mb-0">
                        All records were imported successfully.
                    </div>
                }

            </div>

        </div>

        <div class="mt-3">

            <a
                asp-controller="Dashboard"
                asp-action="Index"
                class="btn btn-outline-primary">
                View Dashboard
            </a>

            <a
                asp-controller="Tickets"
                asp-action="Index"
                class="btn btn-outline-secondary">
                View Tickets
            </a>

        </div>
    }

</div>